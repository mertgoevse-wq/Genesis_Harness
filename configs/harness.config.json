  "workflow": {
    "name": "Genesis Loop",
    "stages": [
      {
        "n": 1,
        "id": "intake",
        "owner": "any",
        "produces": "task contract"
      },
      {
        "n": 2,
        "id": "research",
        "owner": "research",
        "produces": "findings report"
      },
      {
        "n": 3,
        "id": "design",
        "owner": "architect",
        "produces": "architecture spec + ADR"
      },
      {
        "n": 4,
        "id": "plan",
        "owner": "architect",
        "produces": "implementation units"
      },
      {
        "n": 5,
        "id": "build",
        "owner": "coding",
        "produces": "code + verification evidence"
      },
      {
        "n": 6,
        "id": "verify",
        "owner": "qa",
        "produces": "QA report"
      },
      {
        "n": 7,
        "id": "log",
        "owner": "any",
        "produces": "session log"
      },
      {
        "n": 8,
        "id": "commit",
        "owner": "any",
        "produces": "commit + push"
      }
    ]
  }
}