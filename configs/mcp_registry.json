{
  "version": "1.0.0",
  "mcp_servers": [
    {
      "name": "github-mcp",
      "server_url": "mcp://github.com",
      "capabilities": [
        "repo_read",
        "repo_write",
        "issue_create",
        "pr_create"
      ],
      "security_boundary": "ReadWrite",
      "recommended_agents": [
        "coding",
        "architect"
      ]
    },
    {
      "name": "sqlite-mcp",
      "server_url": "mcp://localhost/sqlite",
      "capabilities": [
        "query_read",
        "schema_inspect"
      ],
      "security_boundary": "ReadOnly",
      "recommended_agents": [
        "database-engineer"
      ]
    },
    {
      "name": "browser-mcp",
      "server_url": "mcp://localhost/browser",
      "capabilities": ["dom_read", "screenshot"],
      "security_boundary": "Read",
      "recommended_agents": ["visual-qa-agent"]
    },
    {
      "name": "voice-mcp",
      "server_url": "mcp://localhost/voice",
      "capabilities": ["stt", "tts"],
      "security_boundary": "Execute",
      "recommended_agents": ["voice-agent", "content-agent"]
    },
    {
      "name": "video-mcp",
      "server_url": "mcp://localhost/video",
      "capabilities": ["video_gen"],
      "security_boundary": "Execute",
      "recommended_agents": ["ui-agent"]
    },
    {
      "name": "mobile-mcp",
      "server_url": "mcp://localhost/mobile",
      "capabilities": ["camera", "microphone", "emulator"],
      "security_boundary": "Execute",
      "recommended_agents": ["visual-qa-agent", "ui-agent"]
    }
  ]
}