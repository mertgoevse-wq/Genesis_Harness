        "hha",
        "kha"
      ],
      "why": "Identische Form, Unterscheidung nur ueber den Punkt.",
      "tip": "Punkt innen = Jim. Kein Punkt = Ha. Punkt oben = Kha.",
      "provenance": "verified",
      "sources": [
        {
          "source_id": "editorial-arabic-didactics"
        }
      ]
    },
