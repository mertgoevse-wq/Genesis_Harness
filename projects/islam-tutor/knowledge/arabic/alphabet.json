    {
      "unit": 1,
      "title": "Buchstaben mit deutscher Entsprechung",
      "goal": "Die Buchstaben erkennen und schreiben, deren Laut aus dem Deutschen bekannt ist.",
      "letters": [
        "ba",
        "ta",
        "dal",
        "ra",
        "zay",
        "sin",
