# Genesis environment variables
# Copy this file to .env and fill in the values for the integrations you want.

# LLM provider: fallback (default, offline), anthropic, or openai
LLM_PROVIDER=fallback
LLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Provider API keys (only required when LLM_PROVIDER is set to that provider)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
